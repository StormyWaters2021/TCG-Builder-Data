                ]
              }
            }
          ]
        },
        {
          "name": "Sensei",
          "maxColumns": 1,
          "groups": [
            {
              "name": "Sensei",
              "match": {
                "Type": "Sensei"
              }
            },
            {
              "name": "Sensei",
              "match": {
                "OCTGN": "Sensei Deck"
              }
            }
          ]
        }
      ]
    }
  },
  "features": {
    "seasons": true,
    "formats": true
  },
  "styleDetection": {
    "method": "cardMatch",
    "matchProperty": "Type",
